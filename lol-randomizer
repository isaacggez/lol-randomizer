<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>LoL Randomizer</title>
<link href="https://fonts.googleapis.com/css2?family=Marcellus&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{--bg:#010a13;--n1:#0a1428;--n2:#0a323c;--gold:#c8aa6e;--gd:#785a28;--gl:#f0e6d2;--hex:#0ac8b9;--st:#a09b8c;--st2:#5b5a56;--bl:#4aa8ff;--rd:#e8505b;--disp:'Marcellus','Trajan Pro','Palatino Linotype',Georgia,serif;--body:'Inter','Segoe UI',system-ui,-apple-system,sans-serif}
*{box-sizing:border-box;margin:0}
body{-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;text-rendering:optimizeLegibility;font-family:var(--body);color:var(--gl);line-height:1.45;background:repeating-linear-gradient(45deg,#ffffff06 0 1px,transparent 1px 8px),radial-gradient(ellipse at 75% 0,#0a323c88,transparent 55%),linear-gradient(#0a1428,#010a13 480px),var(--bg);background-attachment:fixed;min-height:100vh}
.top{position:sticky;top:0;z-index:5;display:flex;justify-content:space-between;align-items:center;height:56px;padding:0 22px;background:linear-gradient(#0a1428,#010a13);border-bottom:1px solid var(--gd);box-shadow:0 2px 0 #000}
.brand{display:flex;align-items:center;gap:10px;font:400 17px var(--disp);letter-spacing:.12em}
.brand svg{width:30px;height:30px}
nav{display:flex;height:100%}
nav button{background:none;border:0;border-bottom:2px solid transparent;color:var(--st);font:600 14px var(--body);letter-spacing:.06em;padding:0 16px;cursor:pointer;transition:.15s}
nav button:hover{color:var(--gl)}
nav button.on{color:var(--gold);border-color:var(--gold)}
.wrap{max-width:1040px;margin:0 auto;padding:30px 18px 70px}
.screen{display:none}.screen.on{display:block;animation:in .3s ease}
@keyframes in{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
.hero{display:grid;grid-template-columns:1.25fr .75fr;align-items:center;gap:20px;margin-bottom:26px}
h1{font:400 clamp(42px,8vw,78px)/.95 var(--disp);letter-spacing:.03em;background:linear-gradient(180deg,#f0e6d2,#c8aa6e 50%,#785a28);-webkit-background-clip:text;background-clip:text;color:transparent}
.hero p{color:var(--st);max-width:440px;margin-top:14px;font-size:17px}
.rune{width:100%;max-width:230px;justify-self:center;filter:drop-shadow(0 0 22px #0ac8b933)}
h2{display:flex;align-items:center;gap:14px;font:400 15px var(--disp);letter-spacing:.1em;color:var(--gold);margin:26px 0 12px}
h2::after{content:"";flex:1;height:1px;background:linear-gradient(90deg,var(--gd),transparent)}
.frame{border:1px solid var(--gd);background:linear-gradient(180deg,#0a1428,#071020);box-shadow:inset 0 0 0 3px #010a13,inset 0 0 0 4px #3a2e14;position:relative}
.modes{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.mode{display:flex;gap:16px;align-items:center;text-align:left;cursor:pointer;color:inherit;font:inherit;padding:22px;transition:.2s}
.mode .hx{flex:none;width:62px;height:70px;clip-path:polygon(50% 0,100% 25%,100% 75%,50% 100%,0 75%,0 25%);background:var(--gd);display:grid;place-items:center;transition:.2s}
.mode .hx i{width:58px;height:66px;clip-path:inherit;background:#0a1428;display:grid;place-items:center}
.mode svg{width:34px;height:34px}
.mode b{display:block;font:400 19px var(--disp);letter-spacing:.04em}
.mode span{color:var(--st);font-size:15px}
.mode:hover{border-color:var(--gold)}
.mode.sel{border-color:var(--gold);background:linear-gradient(180deg,#0f2447,#0a1428);box-shadow:inset 0 0 0 3px #010a13,inset 0 0 0 4px var(--gd),0 0 26px #c8aa6e1f}
.mode.sel .hx{background:var(--gold)}
.mode.sel::after{content:"";position:absolute;left:20%;right:20%;top:-1px;height:2px;background:var(--hex);box-shadow:0 0 10px var(--hex)}
.seg{display:flex}
.size{flex:1;cursor:pointer;padding:12px 4px 10px;color:var(--st);background:#0a1428;border:1px solid var(--gd);margin-left:-1px;font:inherit;transition:.15s}
.size b{display:block;font:400 22px var(--disp);color:var(--gl)}
.size span{font-size:12px}
.size:hover{background:#0f2447;color:var(--gl)}
.size.sel{background:linear-gradient(180deg,#15325c,#0a1428);color:var(--gold);border-bottom:3px solid var(--gold);z-index:1}
.size.sel b{color:var(--gold)}
.foot{display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap;margin-top:24px}
.foot p{color:var(--st)}
.btn{cursor:pointer;font:600 14px var(--body);letter-spacing:.08em;padding:11px 20px;color:var(--gl);background:linear-gradient(#1e2328,#0a0e13);border:1px solid var(--gd);box-shadow:inset 0 0 0 2px #010a13;transition:.15s}
.btn:hover{border-color:var(--gold);color:#fff;box-shadow:inset 0 0 0 2px #010a13,0 0 14px #c8aa6e2a}
.btn:active{transform:translateY(1px);filter:brightness(.9)}
.btn:focus-visible,.size:focus-visible,.mode:focus-visible,nav button:focus-visible{outline:2px solid var(--hex);outline-offset:2px}
.btn.pri{font:400 16px var(--disp);letter-spacing:.1em;padding:15px 40px;color:#1a1204;border-color:#f0e6d2;background:linear-gradient(#f0d994,#c8aa6e 55%,#8f6c2c);box-shadow:inset 0 0 0 2px #00000055}
.btn.pri:hover{filter:brightness(1.12);color:#000}
.btn.sec{background:transparent;color:var(--st);border-color:var(--st2)}
.btn.sec:hover{color:var(--gl);border-color:var(--st)}
.btn.done{border-color:var(--hex);color:var(--hex)}
.btn[disabled]{opacity:.45;cursor:wait}
.bar{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap}
.bar h2{margin:0;flex:1}
.pips{display:flex;gap:5px;margin:4px 0 6px}
.pips i{flex:1;height:5px;background:#1e2328;transition:.2s}
.pips i.f{background:linear-gradient(90deg,var(--gold),#f0d994);box-shadow:0 0 6px #c8aa6e55}
.cnt{color:var(--st);font-size:15px;margin-bottom:16px}.cnt b{color:var(--gold)}
.fields{display:grid;grid-template-columns:repeat(auto-fit,minmax(290px,1fr));gap:10px}
.fld{display:flex;align-items:center;gap:12px;padding:8px 14px 8px 8px;background:#050d19;border:1px solid #3c3c41;transition:.15s}
.fld .n{flex:none;width:34px;height:38px;clip-path:polygon(50% 0,100% 25%,100% 75%,50% 100%,0 75%,0 25%);background:#1e2328;color:var(--st);display:grid;place-items:center;font:400 14px var(--disp);transition:.15s}
.fld input{flex:1;min-width:0;background:transparent;border:0;outline:0;color:#fff;font:500 19px var(--body);padding:6px 0}
.fld input::placeholder{color:var(--st2)}
.fld:focus-within{border-color:var(--gold);background:#0a1a30;box-shadow:0 0 0 1px var(--gold),0 0 18px #c8aa6e2a}
.fld:focus-within .n{background:var(--gold);color:#1a1204}
.fld.ok .n{background:var(--gd);color:var(--gl)}
.fld.err{border-color:var(--rd)}
.hint{color:var(--st);font-size:14px;margin-top:14px}
kbd{border:1px solid var(--st2);background:#0a0e13;padding:0 6px;font:600 12px var(--body)}
.actions{display:flex;gap:10px;flex-wrap:wrap;margin:16px 0 22px}
.actions .gap{flex:1}
.cs{display:grid;grid-template-columns:1fr 54px 1fr;gap:0;align-items:start}
.cs.one{grid-template-columns:minmax(0,520px);justify-content:center}
.vs{align-self:center;text-align:center;font:400 20px var(--disp);color:var(--gd)}
.side{overflow:hidden;position:relative}
.side>h3{font:400 20px var(--disp);letter-spacing:.1em;padding:14px 18px;border-bottom:1px solid #ffffff12}
.side.b>h3{color:var(--bl);background:linear-gradient(90deg,#4aa8ff26,transparent)}
.side.r>h3{color:var(--rd);text-align:right;background:linear-gradient(270deg,#e8505b26,transparent)}
.side.m>h3{color:var(--hex);background:linear-gradient(90deg,#0ac8b926,transparent)}
.side.b{border-left:3px solid var(--bl)}.side.r{border-right:3px solid var(--rd)}.side.m{border-left:3px solid var(--hex)}
.row{display:flex;align-items:center;gap:14px;padding:10px 16px;border-bottom:1px solid #ffffff0d;animation:rev .35s both;animation-delay:calc(var(--i)*70ms)}
.row:last-child{border:0}
.r .row{flex-direction:row-reverse;text-align:right}
@keyframes rev{from{opacity:0;transform:translateX(-10px)}to{opacity:1;transform:none}}
.r .row{--dx:10px}
.pt{flex:none;width:58px;height:58px;position:relative;border:2px solid var(--gd);background:#0a1428;display:grid;place-items:center;overflow:hidden;box-shadow:0 0 0 1px #010a13}
.pt b{font:400 24px var(--disp);color:var(--gold)}
.pt img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.tx{flex:1;min-width:0;display:flex;flex-direction:column}
.pl{font:600 19px var(--body);overflow-wrap:anywhere}
.ch{font-size:15px;color:var(--hex)}
.rl{flex:none;width:62px;display:flex;flex-direction:column;align-items:center;gap:1px}
.rl img,.rl svg{width:28px;height:28px;object-fit:contain}
.rl em{font:600 10px var(--body);font-style:normal;letter-spacing:.1em;color:var(--st)}
.note{padding:16px 18px;color:var(--st);font-size:15px}
.rolling .side::after{content:"";position:absolute;inset:0;background:linear-gradient(100deg,transparent 35%,#c8aa6e33 50%,transparent 65%);animation:sw .6s linear infinite}
.rolling .row{opacity:.4;filter:blur(1.5px)}
@keyframes sw{from{transform:translateX(-100%)}to{transform:translateX(100%)}}
#pt{width:100%;resize:vertical;background:#050d19;color:#fff;border:1px solid #3c3c41;padding:10px 12px;font:500 17px/1.5 var(--body);outline:0}
#pt:focus{border-color:var(--gold);box-shadow:0 0 0 1px var(--gold)}
#modal{position:fixed;inset:0;background:#000000d0;display:grid;place-items:center;z-index:20;padding:14px}
#modal[hidden]{display:none}
.mbox{width:min(780px,100%);max-height:96vh;display:flex;flex-direction:column;padding:16px}
.mbox h2{margin:0}
.mcv{overflow:auto;margin:12px 0}
#cv{width:100%;height:auto;display:block;border:1px solid var(--gd)}
#toast{position:fixed;left:50%;bottom:26px;transform:translate(-50%,16px);opacity:0;pointer-events:none;display:flex;gap:10px;align-items:center;background:#0a1428;border:1px solid var(--gold);box-shadow:inset 0 0 0 2px #010a13;color:var(--gl);padding:11px 20px;transition:.25s;z-index:9;max-width:92vw}
#toast.on{opacity:1;transform:translate(-50%,0)}
#toast i{width:9px;height:9px;background:var(--hex);transform:rotate(45deg);flex:none}
#manual{display:none;margin-top:18px}
#manual textarea{width:100%;height:230px;background:#050d19;color:var(--gl);border:1px solid var(--gold);padding:12px;font:15px/1.5 var(--body)}
@media(max-width:760px){.hero{grid-template-columns:1fr}.rune{display:none}.modes{grid-template-columns:1fr}.cs{grid-template-columns:1fr;gap:14px}.vs{display:none}.btn{flex:1 1 44%}.actions .gap{display:none}.brand span{display:none}.size span{display:none}}
</style>
</head>
<body>
<header class="top">
  <div class="brand"><svg id="logo" viewBox="0 0 48 48"></svg><span>LOL RANDOMIZER</span></div>
  <nav><button data-s="s-home">Partida</button><button data-s="s-reg">Jogadores</button><button data-s="s-res">Resultado</button></nav>
</header>
<div class="wrap">

<section class="screen on" id="s-home">
  <div class="hero">
    <div><h1>LoL<br>Randomizer</h1><p>Monte a próxima partida com os amigos: divida os times, sorteie as posições e entregue um campeão para cada invocador.</p></div>
    <svg class="rune" viewBox="0 0 200 200" fill="none" stroke="#c8aa6e">
      <polygon points="100,6 181,53 181,147 100,194 19,147 19,53" stroke-width="2"/>
      <polygon points="100,22 167,61 167,139 100,178 33,139 33,61" stroke="#785a28"/>
      <circle cx="100" cy="100" r="52" stroke="#0ac8b9" stroke-width="1.5" stroke-dasharray="3 6"/>
      <g stroke-width="5" stroke-linecap="round"><path d="M72 72l56 56M128 72L72 128" stroke="#f0e6d2"/><path d="M64 80l16-16M136 80l-16-16M64 120l16 16M136 120l-16 16"/></g>
      <rect x="95" y="1" width="10" height="10" fill="#0ac8b9" stroke="none" transform="rotate(45 100 6)"/>
    </svg>
  </div>
  <h2>MODO DE JOGO</h2>
  <div class="modes">
    <button class="mode frame sel" data-m="closed"><div class="hx"><i><svg id="ic-c" viewBox="0 0 48 48"></svg></i></div><div><b>Partida Fechada</b><span>Informe todos os participantes. O site divide em Time Azul e Time Vermelho.</span></div></button>
    <button class="mode frame" data-m="random"><div class="hx"><i><svg id="ic-r" viewBox="0 0 48 48"></svg></i></div><div><b>Contra Randoms</b><span>Informe só o seu time.</span></div></button>
  </div>
  <h2>JOGADORES POR EQUIPE</h2>
  <div class="seg" id="sizes"></div>
  <div class="foot"><p id="need"></p><button class="btn pri" id="go">CADASTRAR JOGADORES</button></div>
</section>

<section class="screen" id="s-reg">
  <div class="bar"><h2 id="reg-title"></h2><button class="btn sec" id="paste-btn">Colar lista</button><button class="btn sec" id="back1">Voltar</button></div>
  <div id="paste" class="frame" hidden style="padding:14px;margin:6px 0 14px"><label for="pt" class="cnt" style="display:block;margin-bottom:8px">Cole os nomes, um por linha (ou separados por vírgula).</label><textarea id="pt" rows="5" placeholder="João&#10;Pedro&#10;Lucas"></textarea><div class="foot" style="margin-top:10px"><button class="btn sec" id="pt-cancel">Cancelar</button><button class="btn" id="pt-ok">Feito</button></div></div>
  <div class="pips" id="pips"></div>
  <div class="cnt" id="count"></div>
  <div class="fields" id="fields"></div>
  <p class="hint"><kbd>Enter</kbd> vai ao próximo campo, <kbd>Shift</kbd> + <kbd>Enter</kbd> volta. No último campo, <kbd>Enter</kbd> avança.<br>Já tem uma lista? Cole em qualquer campo com <kbd>Ctrl</kbd> + <kbd>V</kbd> ou use “Colar lista”.</p>
  <div class="foot"><span></span><button class="btn pri" id="next">CONTINUAR</button></div>
</section>

<section class="screen" id="s-res">
  <div class="bar"><h2 id="res-title"></h2><button class="btn sec" id="edit">Editar nomes</button></div>
  <div class="actions">
    <button class="btn" id="b-teams">Sortear times</button>
    <button class="btn" id="b-roles">Sortear posições</button>
    <button class="btn" id="b-champs">Sortear campeões</button>
    <span class="gap"></span>
    <button class="btn" id="b-copy">Copiar resultado</button>
    <button class="btn" id="b-img">🖼️ Gerar imagem</button>
    <button class="btn sec" id="b-all">Nova tentativa de sorteio</button>
    <button class="btn sec" id="b-new">Nova partida</button>
  </div>
  <div class="cs" id="teams"></div>
  <div id="manual"><p class="cnt">Não foi possível copiar automaticamente. Copie o texto abaixo.</p><textarea id="ta" readonly></textarea></div>
</section>

</div>
<div id="modal" hidden><div class="mbox frame" role="dialog" aria-label="Prévia da imagem"><div class="bar"><h2>PRÉVIA DA IMAGEM</h2><button class="btn sec" id="m-close">Fechar</button></div><div class="mcv"><canvas id="cv"></canvas></div><div class="foot" style="margin-top:0"><span></span><button class="btn pri" id="m-dl">📥 Baixar imagem</button></div></div></div>
<div id="toast" role="status" aria-live="polite"></div>

<script>
const ROLES=['TOP','JUNGLE','MID','ADC','SUPPORT'],LAB=['Top','Jungle','Mid','ADC','Support'];
/* ===== BANCO DE CAMPEÕES (edite só aqui) =====
   Formato: "Nome:ROTAS". Rotas possíveis: T=TOP, J=JUNGLE, M=MID, A=ADC, S=SUPPORT.
   São funções possíveis do campeão, não garantia de força no meta atual. */
const CHAMPION_DB=`Aatrox:T,Ahri:M,Akali:MT,Akshan:M,Alistar:S,Ambessa:T,Amumu:J,Anivia:M,Annie:M,Aphelios:A,Ashe:A,Aurelion Sol:MA,Aurora:M,Azir:M,Bard:S,Bel'Veth:J,Blitzcrank:S,Brand:S,Braum:S,Briar:J,Caitlyn:A,Camille:TS,Cassiopeia:MT,Cho'Gath:TJ,Corki:AT,Darius:T,Diana:JM,Dr. Mundo:T,Draven:A,Ekko:MJ,Elise:J,Evelynn:J,Ezreal:A,Fiddlesticks:J,Fiora:T,Fizz:M,Galio:M,Gangplank:T,Garen:T,Gnar:T,Gragas:TJ,Graves:J,Gwen:TJ,Hecarim:J,Heimerdinger:T,Hwei:M,Illaoi:T,Irelia:TM,Ivern:J,Janna:S,Jarvan IV:J,Jax:T,Jayce:T,Jhin:A,Jinx:A,K'Sante:T,Kai'Sa:A,Kalista:A,Karma:S,Karthus:J,Kassadin:M,Katarina:M,Kayle:T,Kayn:J,Kennen:T,Kha'Zix:J,Kindred:J,Kled:T,Kog'Maw:A,LeBlanc:M,Lee Sin:J,Leona:S,Lillia:J,Lissandra:M,Locke:M,Lucian:A,Lulu:S,Lux:SM,Malphite:T,Malzahar:M,Maokai:SJ,Master Yi:J,Mel:MS,Milio:S,Miss Fortune:A,Mordekaiser:T,Morgana:S,Naafiri:JM,Nami:S,Nasus:T,Nautilus:S,Neeko:S,Nidalee:J,Nilah:A,Nocturne:J,Nunu e Willump:J,Olaf:T,Orianna:M,Ornn:T,Pantheon:ST,Poppy:ST,Pyke:S,Qiyana:JM,Quinn:JT,Rakan:S,Rammus:J,Rek'Sai:J,Rell:S,Renata Glasc:S,Renekton:T,Rengar:J,Riven:T,Rumble:T,Ryze:M,Samira:A,Sejuani:J,Senna:S,Seraphine:S,Sett:T,Shaco:JS,Shen:T,Shyvana:J,Singed:T,Sion:T,Sivir:A,Skarner:J,Smolder:A,Sona:S,Soraka:S,Swain:S,Sylas:MJ,Syndra:M,Tahm Kench:ST,Taliyah:MJ,Talon:JM,Taric:S,Teemo:T,Thresh:S,Tristana:A,Trundle:TJ,Tryndamere:T,Twisted Fate:M,Twitch:A,Udyr:JT,Urgot:T,Varus:AT,Vayne:AT,Veigar:MA,Vel'Koz:SM,Vex:M,Vi:J,Viego:J,Viktor:MA,Vladimir:MT,Volibear:TJ,Warwick:JT,Wukong:J,Xayah:A,Xerath:MS,Xin Zhao:J,Yasuo:MT,Yone:MT,Yorick:T,Yunara:A,Yuumi:S,Zaahen:T,Zac:J,Zed:MJ,Zeri:A,Ziggs:AM,Zilean:S,Zoe:MS,Zyra:SJ`;
/* CH[posição] = lista de campeões; índices: 0 TOP, 1 JUNGLE, 2 MID, 3 ADC, 4 SUPPORT */
const CH=[[],[],[],[],[]];
CHAMPION_DB.split(',').forEach(e=>{const [n,r]=e.split(':');[...r].forEach(c=>CH['TJMAS'.indexOf(c)].push(n))});

const $=id=>document.getElementById(id);
/* retratos: Data Dragon (Riot); sem internet aparece o monograma */
const DD={v:'15.20.1'};
const SPECIAL={'Wukong':'MonkeyKing','Nunu e Willump':'Nunu','Renata Glasc':'Renata',"Kai'Sa":'Kaisa',"Vel'Koz":'Velkoz',"Bel'Veth":'Belveth',"Kha'Zix":'Khazix',"Cho'Gath":'Chogath','LeBlanc':'Leblanc'};
const ddId=n=>SPECIAL[n]||n.replace(/[^A-Za-z]/g,'');
fetch('https://ddragon.leagueoflegends.com/api/versions.json').then(r=>r.json()).then(v=>{DD.v=v[0];if(S.champs&&$('s-res').classList.contains('on'))renderRes()}).catch(()=>{});

/* ícones */
const SW='<g stroke="#c8aa6e" stroke-width="3.2" stroke-linecap="round" fill="none"><path d="M12 12l24 24M36 12L12 36"/><path d="M8 18l10-10M40 18L30 8M8 30l10 10M40 30L30 40"/></g>';
$('logo').innerHTML='<polygon points="24,2 44,13 44,35 24,46 4,35 4,13" fill="#0a1428" stroke="#c8aa6e" stroke-width="2"/>'+SW.replace('3.2','2.6');
$('ic-c').innerHTML=SW;
$('ic-r').innerHTML='<path d="M24 5l15 5v12c0 10-6 17-15 21C15 39 9 32 9 22V10z" fill="none" stroke="#c8aa6e" stroke-width="2.6" stroke-linejoin="round"/><path d="M24 15l6 6-6 12-6-12z" fill="#0ac8b9"/>';
const HL=['<path d="M4 20V4h16"/>','<path d="M8 8l-1-1M16 16"/><circle cx="8" cy="13" r="2.4"/><circle cx="16" cy="11" r="2.4"/>','<path d="M4 20L20 4"/>','<path d="M12 20h8V12"/>','<path d="M6 20h12"/><circle cx="12" cy="20" r="2.4"/>'];
const RI=['top','jungle','middle','bottom','utility'].map(n=>`https://raw.communitydragon.org/latest/plugins/rcp-fe-lol-clash/global/default/assets/images/position-selector/positions/icon-position-${n}.png`);
function roleFb(img,r){img.outerHTML=ico(r)}
const rIcon=r=>`<img src="${RI[r]}" alt="${LAB[r]}" onerror="roleFb(this,${r})">`;
const ico=r=>`<svg viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round"><g stroke="#5b5a56" stroke-width="2"><path d="M4 20V4h16M4 20L20 4M4 20h16V4"/></g><g stroke="#c8aa6e" fill="#c8aa6e" stroke-width="2.8">${HL[r]}</g></svg>`;

const esc=s=>s.replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const S={mode:'closed',n:5,names:Array(10).fill(''),teams:null,roles:false,champs:false,sig:'',ready:false,busy:false};

function rnd(max){const a=new Uint32Array(1),lim=Math.floor(4294967296/max)*max;do{crypto.getRandomValues(a)}while(a[0]>=lim);return a[0]%max}
function shuffle(arr){const a=arr.slice();for(let i=a.length-1;i>0;i--){const j=rnd(i+1);[a[i],a[j]]=[a[j],a[i]]}return a}
const need=()=>S.mode==='closed'?S.n*2:S.n;
const clean=()=>S.names.slice(0,need()).map(s=>s.trim());
function toast(msg){const t=$('toast');t.innerHTML='<i></i><span></span>';t.lastChild.textContent=msg;t.classList.add('on');clearTimeout(toast.h);toast.h=setTimeout(()=>t.classList.remove('on'),2400)}
function show(id){document.querySelectorAll('.screen').forEach(s=>s.classList.toggle('on',s.id===id));document.querySelectorAll('nav button').forEach(b=>b.classList.toggle('on',b.dataset.s===id));window.scrollTo(0,0)}
function resetResults(){S.teams=null;S.roles=false;S.champs=false;S.ready=false;$('manual').style.display='none'}
function goReg(){renderReg();show('s-reg');focusField(0)}
document.querySelector('nav').onclick=e=>{const b=e.target.closest('button');if(!b)return;const s=b.dataset.s;
  if(s==='s-home'){renderHome();show(s)}else if(s==='s-reg')goReg();else if(S.ready){renderRes();show(s)}else confirmNames()};

/* ---------- Início ---------- */
function renderHome(){
  document.querySelectorAll('.mode').forEach(b=>b.classList.toggle('sel',b.dataset.m===S.mode));
  $('sizes').innerHTML=[1,2,3,4,5].map(n=>`<button class="size ${n===S.n?'sel':''}" data-n="${n}"><b>${n}v${n}</b><span>${S.mode==='closed'?n*2:n} nome${(S.mode==='closed'?n*2:n)>1?'s':''}</span></button>`).join('');
  $('need').textContent=S.mode==='closed'?`Serão necessários ${S.n*2} nomes, ${S.n} por time.`:`Serão necessários ${S.n} nome${S.n>1?'s':''}, apenas do seu time.`;
}
document.querySelectorAll('.mode').forEach(b=>b.onclick=()=>{if(S.mode!==b.dataset.m){S.mode=b.dataset.m;resetResults()}renderHome()});
$('sizes').onclick=e=>{const b=e.target.closest('.size');if(!b)return;const n=+b.dataset.n;if(n!==S.n){S.n=n;resetResults()}renderHome()};
$('go').onclick=goReg;

/* ---------- Cadastro ---------- */
function renderReg(){
  const k=need();$('paste').hidden=true;
  $('reg-title').textContent=(S.mode==='closed'?'PARTIDA FECHADA':'CONTRA RANDOMS')+` · ${S.n}V${S.n}`;
  $('fields').innerHTML=Array.from({length:k},(_,i)=>`<div class="fld" data-i="${i}"><span class="n">${i+1}</span><input id="n${i}" data-i="${i}" maxlength="24" autocomplete="off" aria-label="Jogador ${i+1}" enterkeyhint="${i===k-1?'done':'next'}" value="${esc(S.names[i])}" placeholder="${S.mode==='closed'?'Nome do jogador':'Jogador do meu time'}"></div>`).join('');
  $('pips').innerHTML='<i></i>'.repeat(k);
  updateCount();
}
function updateCount(){
  const k=need(),c=clean(),f=c.filter(Boolean).length;
  $('count').innerHTML=`<b>${f} de ${k}</b> jogadores cadastrados`;
  document.querySelectorAll('#pips i').forEach((p,i)=>p.classList.toggle('f',!!c[i]));
  document.querySelectorAll('.fld').forEach(el=>{const v=!!c[+el.dataset.i];el.classList.toggle('ok',v);if(v)el.classList.remove('err')});
}
function focusField(i){const el=$('n'+i);if(el){el.focus();el.select()}}
function confirmNames(){
  const c=clean(),i=c.findIndex(v=>!v);
  if(i>=0){if(!$('s-reg').classList.contains('on')){renderReg();show('s-reg')}toast('Preencha todos os nomes antes de continuar.');$('n'+i).closest('.fld').classList.add('err');focusField(i);return}
  const sig=c.join('\u0001')+S.mode+S.n;
  if(sig!==S.sig){resetResults();S.sig=sig}
  S.ready=true;
  if(S.mode==='random'&&!S.teams)S.teams={blue:c.map(name=>({name,role:null,champ:null}))};
  renderRes();show('s-res');
}
$('fields').addEventListener('input',e=>{if(e.target.dataset.i!==undefined){S.names[+e.target.dataset.i]=e.target.value;updateCount()}});
$('fields').addEventListener('keydown',e=>{
  if(e.key!=='Enter'||e.isComposing)return;
  e.preventDefault();
  const i=+e.target.dataset.i,k=need();
  if(e.shiftKey){if(i>0)focusField(i-1);return}
  if(i<k-1)focusField(i+1);else confirmNames();
});
$('next').onclick=confirmNames;

/* ---------- Colar lista de nomes ---------- */
const parseNames=t=>t.split(/[\r\n;,\t]+/).map(x=>x.replace(/^\s*(?:\d+[.)\-:]|[-*•·])\s*/,'').trim().slice(0,24)).filter(Boolean);
function fillNames(list,start){
  const k=need(),room=k-start,use=list.slice(0,Math.max(room,0));
  use.forEach((n,j)=>{S.names[start+j]=n;const el=$('n'+(start+j));if(el)el.value=n});
  updateCount();
  const c=clean(),empty=c.findIndex(v=>!v);
  focusField(empty>=0?empty:k-1);
  const extra=list.length-use.length;
  toast(`${use.length} nome${use.length>1?'s':''} preenchido${use.length>1?'s':''}`+(extra>0?`. ${extra} ficou${extra>1?'ram':''} de fora (só cabem ${k}).`:'.'));
}
$('fields').addEventListener('paste',e=>{
  if(e.target.dataset.i===undefined)return;
  const list=parseNames((e.clipboardData||window.clipboardData).getData('text'));
  if(list.length<2)return;
  e.preventDefault();fillNames(list,+e.target.dataset.i);
});
$('paste-btn').onclick=()=>{const p=$('paste');p.hidden=!p.hidden;if(!p.hidden)$('pt').focus()};
$('pt-cancel').onclick=()=>{$('paste').hidden=true;focusField(0)};
$('pt-ok').onclick=()=>{
  const list=parseNames($('pt').value);
  if(!list.length){toast('Cole pelo menos um nome.');$('pt').focus();return}
  fillNames(list,0);$('pt').value='';$('paste').hidden=true;
};
$('pt').addEventListener('keydown',e=>{if(e.key==='Enter'&&(e.ctrlKey||e.metaKey)){e.preventDefault();$('pt-ok').click()}});
$('back1').onclick=()=>{renderHome();show('s-home')};

/* ---------- Sorteios ---------- */
function drawTeams(){
  const c=shuffle(clean().map(name=>({name,role:null,champ:null})));
  S.teams={blue:c.slice(0,S.n),red:c.slice(S.n)};S.roles=false;S.champs=false;
}
function drawRoles(){
  for(const t of Object.values(S.teams)){const r=shuffle([0,1,2,3,4]);t.forEach((p,i)=>{p.role=r[i];p.champ=null})}
  S.roles=true;S.champs=false;
}
function drawChamps(){
  const used=new Set();
  /* rotas com menos opções sorteiam primeiro; assim os flex picks não faltam onde há poucas escolhas */
  const all=shuffle(Object.values(S.teams).flat()).sort((a,b)=>(a.role==null?9e9:CH[a.role].length)-(b.role==null?9e9:CH[b.role].length));
  for(const p of all){
    /* sem posição (equipes com menos de 5): sorteia entre todos os campeões */
    const src=p.role==null?ALL_CH:CH[p.role];
    let pool=src.filter(c=>!used.has(c));
    if(!pool.length)pool=src;
    p.champ=pool[rnd(pool.length)];used.add(p.champ);
  }
  S.champs=true;
}
const ALL_CH=[...new Set(CH.flat())];
const sorted=t=>t.slice().sort((a,b)=>S.roles?a.role-b.role:0);
function roll(fn,msg){
  if(S.busy)return;S.busy=true;
  const t=$('teams');t.classList.add('rolling');
  document.querySelectorAll('.actions .btn').forEach(b=>b.disabled=true);
  setTimeout(()=>{fn();S.busy=false;t.classList.remove('rolling');document.querySelectorAll('.actions .btn').forEach(b=>b.disabled=false);renderRes();toast(msg)},600);
}
$('b-teams').onclick=()=>roll(drawTeams,'Times sorteados.');
$('b-roles').onclick=()=>{
  if(!S.teams){toast('Sorteie os times antes das posições.');return}
  roll(drawRoles,'Posições sorteadas.')};
$('b-champs').onclick=()=>{
  if(!S.teams){toast('Sorteie os times antes de escolher os campeões.');return}
  if(S.n===5&&!S.roles){toast('Sorteie as posições antes de escolher os campeões.');return}
  roll(drawChamps,'Campeões sorteados.')};
$('b-all').onclick=()=>{
  const had={r:S.roles,c:S.champs};
  roll(()=>{if(S.mode==='closed')drawTeams();if(S.n<5){if(had.c)drawChamps()}else if(had.r){drawRoles();if(had.c)drawChamps()}},'Novo sorteio feito.')};
$('b-new').onclick=()=>{
  if(S.busy)return;S.names=Array(10).fill('');S.sig='';resetResults();renderHome();show('s-home');toast('Nova partida iniciada.')};
$('edit').onclick=goReg;

/* ---------- Resultado ---------- */
function slot(p){
  if(p.champ)return `<span class="pt"><b>${esc(p.champ[0])}</b><img alt="${esc(p.champ)}" src="https://ddragon.leagueoflegends.com/cdn/${DD.v}/img/champion/${ddId(p.champ)}.png" onerror="this.remove()"></span>`;
  return `<span class="pt"><b>${esc(p.name.trim()[0]||'?').toUpperCase()}</b></span>`;
}
function rowHTML(p,i){
  return `<div class="row" style="--i:${i}">${slot(p)}<div class="tx"><span class="pl">${esc(p.name)}</span>${p.champ?`<span class="ch">${esc(p.champ)}</span>`:''}</div>${S.roles?`<span class="rl">${rIcon(p.role)}<em>${ROLES[p.role]}</em></span>`:''}</div>`;
}
function renderRes(){
  const closed=S.mode==='closed';
  $('res-title').textContent=(closed?'PARTIDA FECHADA':'CONTRA RANDOMS')+` · ${S.n}V${S.n}`;
  $('b-teams').style.display=closed?'':'none';
  $('b-roles').style.display=S.n===5?'':'none';
  const el=$('teams');el.className='cs'+(closed?'':' one');
  if(!closed){
    el.innerHTML=`<div class="side m frame"><h3>MEU TIME</h3>${sorted(S.teams.blue).map(rowHTML).join('')}</div>`;return}
  if(!S.teams){
    el.className='cs one';
    el.innerHTML=`<div class="side frame"><h3 style="color:var(--gold)">PARTICIPANTES</h3>${clean().map((n,i)=>rowHTML({name:n},i)).join('')}<p class="note">Clique em “Sortear times” para dividir os jogadores em Azul e Vermelho.</p></div>`;return}
  el.innerHTML=`<div class="side b frame"><h3>TIME AZUL</h3>${sorted(S.teams.blue).map(rowHTML).join('')}</div><div class="vs">VS</div><div class="side r frame"><h3>TIME VERMELHO</h3>${sorted(S.teams.red).map(rowHTML).join('')}</div>`;
}

/* ---------- Copiar ---------- */
function buildText(){
  const closed=S.mode==='closed';
  if(!S.teams)return '';
  const line=p=>{let s='• ';if(S.roles)s+=LAB[p.role]+': ';s+=p.name;if(p.champ)s+=' — '+p.champ;return s};
  const blk=(icon,title,t)=>`${icon} **${title}:**\n${sorted(t).map(line).join('\n')}`;
  const head=`⚔️ **${closed?'Partida Fechada':'Contra Randoms'} (${S.n}v${S.n}) - LoL Randomizer** ⚔️`;
  if(!closed)return `${head}\n\n${blk('🔹','MEU TIME',S.teams.blue)}`;
  return `${head}\n\n${blk('🔹','TIME AZUL',S.teams.blue)}\n\n${blk('🔸','TIME VERMELHO',S.teams.red)}`;
}
function fallbackCopy(txt){
  const ta=document.createElement('textarea');ta.value=txt;ta.style.cssText='position:fixed;opacity:0';
  document.body.appendChild(ta);ta.select();let ok=false;
  try{ok=document.execCommand('copy')}catch(e){}
  ta.remove();return ok;
}
$('b-copy').onclick=async()=>{
  const txt=buildText();
  if(!txt){toast('Sorteie os times antes de copiar.');return}
  let ok=false;
  try{if(navigator.clipboard&&window.isSecureContext){await navigator.clipboard.writeText(txt);ok=true}}catch(e){}
  if(!ok)ok=fallbackCopy(txt);
  if(ok){
    $('manual').style.display='none';toast('Resultado copiado!');
    const b=$('b-copy');b.textContent='Copiado ✓';b.classList.add('done');setTimeout(()=>{b.textContent='Copiar resultado';b.classList.remove('done')},1600);
  }else{$('ta').value=txt;$('manual').style.display='block';$('ta').focus();$('ta').select();toast('Não foi possível copiar automaticamente. Copie o texto abaixo.')}
};


/* ---------- Imagem do resultado (canvas) ---------- */
const svgURL=r=>'data:image/svg+xml;utf8,'+encodeURIComponent(ico(r).replace('<svg ','<svg xmlns="http://www.w3.org/2000/svg" width="96" height="96" '));
function loadImg(src,cors=true){return new Promise(res=>{const i=new Image();if(cors)i.crossOrigin='anonymous';i.onload=()=>res(i);i.onerror=()=>res(null);i.src=src;setTimeout(()=>res(null),8000)})}
const DF="'Marcellus','Palatino Linotype',Georgia,serif",BF="'Inter','Segoe UI',system-ui,sans-serif";
async function renderImage(){
  const closed=S.mode==='closed',W=1080,K=1.5,RH=88,GAP=10;
  const secs=closed?[['TIME AZUL',S.teams.blue,'#4aa8ff'],['TIME VERMELHO',S.teams.red,'#e8505b']]:[['MEU TIME',S.teams.blue,'#0ac8b9']];
  const rows=secs.map(x=>sorted(x[1]));
  try{await Promise.all([document.fonts.load('40px Marcellus'),document.fonts.load('600 24px Inter')])}catch(e){}
  const roleImgs=await Promise.all([0,1,2,3,4].map(async r=>(await loadImg(RI[r]))||await loadImg(svgURL(r),false)));
  const ch=new Map();
  await Promise.all(rows.flat().filter(p=>p.champ).map(async p=>ch.set(p,await loadImg(`https://ddragon.leagueoflegends.com/cdn/${DD.v}/img/champion/${ddId(p.champ)}.png`))));
  const head=270,div=80,foot=134,secH=i=>84+rows[i].length*(RH+GAP);
  const H=head+rows.reduce((a,_,i)=>a+secH(i),0)+(secs.length-1)*div+foot;
  const cv=$('cv'),c=cv.getContext('2d');cv.width=W*K;cv.height=H*K;c.setTransform(K,0,0,K,0,0);
  const T=(t,x,y,font,col,al='left',sp=0)=>{c.font=font;c.fillStyle=col;c.textAlign=al;c.letterSpacing=sp+'px';c.fillText(t,x,y);c.letterSpacing='0px'};
  const fit=(t,fam,w,sz,wt='')=>{while(sz>13){c.font=`${wt} ${sz}px ${fam}`;if(c.measureText(t).width<=w)break;sz--}return `${wt} ${sz}px ${fam}`.trim()};
  const dia=(x,y,r,col)=>{c.fillStyle=col;c.beginPath();c.moveTo(x,y-r);c.lineTo(x+r,y);c.lineTo(x,y+r);c.lineTo(x-r,y);c.closePath();c.fill()};
  const line=(x1,x2,y,col,fade)=>{const g=c.createLinearGradient(x1,0,x2,0);g.addColorStop(0,fade==='l'?'transparent':col);g.addColorStop(1,fade==='r'?'transparent':col);c.strokeStyle=g;c.lineWidth=1.5;c.beginPath();c.moveTo(x1,y);c.lineTo(x2,y);c.stroke()};
  /* fundo */
  let g=c.createLinearGradient(0,0,0,H);g.addColorStop(0,'#0a1428');g.addColorStop(1,'#010a13');c.fillStyle=g;c.fillRect(0,0,W,H);
  c.strokeStyle='rgba(255,255,255,.025)';c.lineWidth=1;for(let x=-H;x<W;x+=10){c.beginPath();c.moveTo(x,H);c.lineTo(x+H,0);c.stroke()}
  g=c.createRadialGradient(W/2,0,0,W/2,0,720);g.addColorStop(0,'rgba(10,200,185,.16)');g.addColorStop(1,'transparent');c.fillStyle=g;c.fillRect(0,0,W,H);
  c.strokeStyle='#785a28';c.lineWidth=2;c.strokeRect(20,20,W-40,H-40);c.strokeStyle='rgba(200,170,110,.35)';c.lineWidth=1;c.strokeRect(29,29,W-58,H-58);
  [[20,20],[W-20,20],[20,H-20],[W-20,H-20]].forEach(([x,y])=>dia(x,y,9,'#c8aa6e'));
  /* topo */
  T('RANDOMIZER',W/2,104,`30px ${DF}`,'#c8aa6e','center',16);
  g=c.createLinearGradient(0,120,0,200);g.addColorStop(0,'#f0e6d2');g.addColorStop(.55,'#c8aa6e');g.addColorStop(1,'#785a28');
  T('MATCH RESULT',W/2,196,`84px ${DF}`,g,'center',4);
  line(120,W/2-30,232,'#c8aa6e','l');line(W/2+30,W-120,232,'#c8aa6e','r');dia(W/2,232,8,'#0ac8b9');
  /* times */
  let y=head;
  secs.forEach(([title,,col],i)=>{
    c.fillStyle=col;c.shadowColor=col;c.shadowBlur=14;c.beginPath();c.arc(80,y+18,11,0,7);c.fill();c.shadowBlur=0;
    T(title,106,y+31,`36px ${DF}`,col,'left',5);c.font=`36px ${DF}`;c.letterSpacing='5px';const tw=c.measureText(title).width;c.letterSpacing='0px';
    line(106+tw+24,W-60,y+18,col,'r');
    let ry=y+64;
    rows[i].forEach(p=>{
      c.fillStyle='rgba(10,20,40,.9)';c.fillRect(60,ry,960,RH);c.strokeStyle='rgba(120,90,40,.75)';c.lineWidth=1;c.strokeRect(60.5,ry+.5,959,RH-1);
      c.fillStyle=col;c.fillRect(60,ry,5,RH);
      if(S.roles){const im=roleImgs[p.role];if(im)c.drawImage(im,86,ry+RH/2-23,46,46);T(ROLES[p.role],146,ry+RH/2+7,`600 19px ${BF}`,'#a09b8c','left',2.5)}
      const px=300,py=ry+8,ps=72,img=ch.get(p);
      c.fillStyle='#0a1428';c.fillRect(px,py,ps,ps);
      if(img)c.drawImage(img,px,py,ps,ps);else T((p.name.trim()[0]||'?').toUpperCase(),px+ps/2,py+49,`34px ${DF}`,'#c8aa6e','center');
      c.strokeStyle='#c8aa6e';c.lineWidth=2;c.strokeRect(px+1,py+1,ps-2,ps-2);
      if(p.champ){const f=fit(p.champ,DF,240,30);T(p.champ,px+ps+20,ry+RH/2+10,f,'#f0e6d2')}
      const nf=fit(p.name,BF,330,30,'600');T(p.name,1000,ry+RH/2+10,nf,'#ffffff','right');
      ry+=RH+GAP;
    });
    y+=secH(i);
    if(i<secs.length-1){const dy=y+div/2-10;line(60,W/2-50,dy,'#785a28','l');line(W/2+50,W-60,dy,'#785a28','r');T('VS',W/2,dy+10,`26px ${DF}`,'#c8aa6e','center',2)}
    if(i<secs.length-1)y+=div;
  });
  /* rodapé */
  line(120,W-120,H-108,'#785a28','');
  T('LoL RANDOMIZER',W/2,H-76,`18px ${DF}`,'#c8aa6e','center',8);
  T('lol-randomizer-pro.netlify.app',W/2,H-50,`600 18px ${BF}`,'#0ac8b9','center',.5);
  T('League of Legends é marca registrada da Riot Games, Inc.',W/2,H-26,`12px ${BF}`,'#5b5a56','center');
}
function closeModal(){$('modal').hidden=true}
$('b-img').onclick=async()=>{
  if(!S.teams){toast('Sorteie os times antes de gerar a imagem.');return}
  const b=$('b-img');b.disabled=true;
  try{await renderImage();$('modal').hidden=false;$('m-dl').focus()}
  catch(e){toast('Não foi possível gerar a imagem.')}
  b.disabled=false;
};
$('m-close').onclick=closeModal;
$('modal').addEventListener('click',e=>{if(e.target.id==='modal')closeModal()});
document.addEventListener('keydown',e=>{if(e.key==='Escape')closeModal()});
$('m-dl').onclick=()=>{
  $('cv').toBlob(b=>{
    if(!b){toast('Não foi possível baixar a imagem.');return}
    const a=document.createElement('a');a.href=URL.createObjectURL(b);a.download='lol-randomizer-resultado.png';
    document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(a.href),4000);toast('Imagem baixada!');
  },'image/png');
};

renderHome();
show('s-home');
</script>
